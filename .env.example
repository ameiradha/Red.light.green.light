# GEMINI_API_KEY: Required for Gemini AI question generation on Vercel & AI Studio.
# On Vercel: Add this in Vercel Dashboard -> Project Settings -> Environment Variables.
# In AI Studio: Automatically injected from secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
VITE_GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

